flowchart TB
  subgraph ACCESS[1. Identity and intake boundary]
    direction TB
    U[Client or source connector] --> AUTH[Entra token validation<br/>workspace membership + role]
    AUTH --> API[FastAPI intake]
    API --> ACCEPT[202 Accepted<br/>job ID]
  end

  subgraph CONTROL[2. Durable ingestion control plane]
    direction TB
    API --> SRC[(Private content-addressed<br/>source store)]
    API --> JOB[(PostgreSQL<br/>ingestion jobs)]
    SRC --> W[Independent worker]
    JOB -->|lease claim| W
    W -. stage heartbeat .-> JOB
    JOB -. retry + backoff .-> W
  end

  subgraph DATA[3. AI data plane]
    direction TB
    W --> PARSE[Docling parsing]
    PARSE --> ROUTE[LLM router<br/>confidence gate]
    ROUTE --> CHUNK[Chunks<br/>offsets + hashes]
    CHUNK --> RAG[Embedding retrieval]
    RAG --> CTX[Budgeted context<br/>evidence IDs]
    CTX --> AI[Structured extraction]
    AI --> VALID[Pydantic +<br/>business validation]
  end

  subgraph GOVERN[4. Publication, human control, and evidence]
    direction TB
    VALID --> TX[Transactional publication]
    TX --> DB[(Documents + chunks<br/>business records)]
    TX --> REVIEW[Needs-review queue]
    REVIEW -->|allowlisted corrections| DECIDE[Authorized reviewer<br/>versioned approve or reject]
    DECIDE --> DB
    DECIDE --> AUDIT[(Actor + role<br/>before/after audit)]
    DB --> EVAL[Regression and pilot quality gates<br/>release evidence]
  end

  classDef boundary fill:#eaf3ff,stroke:#1769aa,color:#10233a,stroke-width:2px;
  classDef control fill:#fff4df,stroke:#b66a00,color:#392400,stroke-width:2px;
  classDef ai fill:#edf8f0,stroke:#26834a,color:#12301d,stroke-width:2px;
  classDef govern fill:#f4efff,stroke:#6b4bb5,color:#24173d,stroke-width:2px;
  class U,AUTH,API,ACCEPT boundary;
  class SRC,JOB,W control;
  class PARSE,ROUTE,CHUNK,RAG,CTX,AI,VALID ai;
  class TX,DB,REVIEW,DECIDE,AUDIT,EVAL govern;
